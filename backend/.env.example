# Настройки Argus. Скопируйте этот файл в .env и заполните реальные значения.
# .env НЕ коммитится в git (см. .gitignore) и попадает в ночной архив конфигурации.

# --- База данных ---
# Пароль пользователя argus в PostgreSQL. Хранится только здесь: если переменной
# нет, backend не стартует — так отсутствие пароля видно сразу.
DB_PASSWORD=

# --- Ключ API ---
# Значение заголовка X-API-Key для изменяющих запросов на /api/** (релей присылает
# аннотации). Должен совпадать с api_key в vision\config.prod.yaml.
ARGUS_API_KEY=

# --- Почта ---
# SMTP-настройки для email-уведомлений Argus.
#
# Что нужно для рабочего ящика (не только логин+пароль):
#   MAIL_SMTP_HOST      — сервер исходящих (например smtp.firma.ru)
#   MAIL_SMTP_PORT      — 465 (SSL) или 587 (STARTTLS)
#   MAIL_SMTP_USERNAME  — логин ящика (часто = полный адрес)
#   MAIL_SMTP_PASSWORD  — ПАРОЛЬ ДЛЯ ПРИЛОЖЕНИЙ (не пароль от веб-входа!):
#                         Яндекс/Google/Mail.ru требуют отдельный App-пароль.
#                         Создаётся в настройках безопасности ящика.
#   MAIL_SMTP_SSL / MAIL_SMTP_STARTTLS — шифрование, зависит от порта.
#   MAIL_FROM           — адрес отправителя (обычно тот же, что SMTP_USERNAME)
#   MAIL_TO             — кому слать. НЕСКОЛЬКО адресов через запятую или
#                         точку с запятой:  alice@x.ru, bob@x.ru
#
# Пример для mail.ru:
#   MAIL_SMTP_HOST=smtp.mail.ru
#   MAIL_SMTP_PORT=465
#   MAIL_SMTP_SSL=true, MAIL_SMTP_STARTTLS=false
#   MAIL_SMTP_PASSWORD — "пароль для внешних приложений" из настроек безопасности mail.ru.
MAIL_ENABLED=false
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=465
MAIL_SMTP_USERNAME=you@example.com
MAIL_SMTP_PASSWORD=app-password
MAIL_SMTP_SSL=true
MAIL_SMTP_STARTTLS=false
MAIL_FROM=you@example.com
MAIL_TO=admin@example.com
# Страховка от шторма: максимум писем в час (0 = без лимита)
MAIL_RATE_LIMIT_PER_HOUR=10

# --- Ссылки на снимок в письме ---
# ARGUS_FILE_BASE_URL — база файловой шары, где лежат каталоги дат (тот же
#   каталог, что ARGUS_IMAGES_DIR, расшаренный по SMB). Примеры:
#     ARGUS_FILE_BASE_URL=\\192.168.1.10\images$
#     ARGUS_FILE_BASE_URL=file://192.168.1.10/images$
#   В письме появится кликабельный путь:
#     \\192.168.1.10\images$\2026-10-05\cam-01-alert-20261005-162013-521.jpg
#   Открывается по клику в Outlook/Thunderbird; веб-почта file:-ссылки обычно
#   блокирует, но путь остаётся видимым и копируется.
# ARGUS_PUBLIC_BASE_URL — HTTP-адрес backend (например http://192.168.1.10:8080):
#   добавляет вторую ссылку, которая открывается в браузере.
# ARGUS_FILE_BASE_URL=\\192.168.1.10\images$
# ARGUS_PUBLIC_BASE_URL=http://192.168.1.10:8080

# Каталог для фотографий. ОБЯЗАТЕЛЬНО задавай абсолютным путём на сервере.
# По умолчанию "data/images" — относительный путь, который разворачивается от
# рабочего каталога процесса. Из-за этого фото оказываются не там, откуда их
# потом отдаёт /images/**, и в журнале выходят 404: backend пишет по одному
# пути (запущен из C:\argus), а читает по другому.
ARGUS_IMAGES_DIR=C:/argus/data/images